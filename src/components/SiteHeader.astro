---
import { SITE } from "@/data/site";

const NAV = [
  { href: "/#about", label: "关于" },
  { href: "/#work", label: "项目" },
  { href: "/#writing", label: "博客" },
  { href: "/#contact", label: "联系" },
];
---

<header class="site-header" id="site-header">
  <div class="site-header__inner container">
    <a href="/" class="brand">
      {/* 头像完整显示，不做裁切——插画四角都有内容（左下的背包、
          右下的衣服、四周的雨丝），切掉任何一边都会显得残缺。
          给出 1x/2x/4x 三档，高分屏取更清晰的那张。 */}
      <img
        class="brand__mark"
        src="/avatar-mark-64.webp"
        srcset="
          /avatar-mark-64.webp 1x,
          /avatar-mark-128.webp 2x,
          /avatar-mark-256.webp 4x
        "
        alt=""
        width="64"
        height="64"
        aria-hidden="true"
        decoding="async"
      />
      <span class="brand__name">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <ul class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="site-nav__link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__blog" href={SITE.blog} rel="noopener" target="_blank">
        博客
        <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
          <path
            d="M3.5 8.5 8.5 3.5M4.8 3.5h3.7v3.7"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"></path>
        </svg>
      </a>

      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="切换到暗色主题"
        title="切换到暗色主题"
      >
        <span class="theme-toggle__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
            <circle
              class="theme-toggle__sun"
              cx="12"
              cy="12"
              r="4.2"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <path
              class="theme-toggle__sun"
              d="M12 2.8v2.1M12 19.1v2.1M21.2 12h-2.1M4.9 12H2.8M18.5 5.5l-1.5 1.5M7 17l-1.5 1.5M18.5 18.5 17 17M7 7 5.5 5.5"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
            <path
              class="theme-toggle__moon"
              d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linejoin="round"></path>
          </svg>
        </span>
      </button>

      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开菜单"
      >
        <span class="nav-toggle__bars" aria-hidden="true">
          <span></span><span></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden>
    <ul class="mobile-nav__list">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav__link">
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="mobile-nav__link mobile-nav__link--ext"
          href={SITE.blog}
          rel="noopener"
          target="_blank"
        >
          博客 {SITE.blog.replace(/^https?:\/\//, "")} ↗
        </a>
      </li>
    </ul>
  </div>
</header>
