---
import { SITE, SOCIALS, BLOG_STATS } from "@/data/site";

type FooterLink = { label: string; href: string; ext?: boolean };
type FooterColumn = { title: string; links: FooterLink[] };

const COLUMNS: FooterColumn[] = [
  {
    title: "本站",
    links: [
      { label: "关于我", href: "/#about" },
      { label: "做过的项目", href: "/#work" },
      { label: "最近写作", href: "/#writing" },
      { label: "联系方式", href: "/#contact" },
    ],
  },
  {
    title: "去别处",
    links: [
      { label: "博客", href: SITE.blog, ext: true },
      { label: "RSS 订阅", href: BLOG_STATS.rss, ext: true },
      { label: "服务状态", href: SITE.status, ext: true },
      { label: "站点地图", href: BLOG_STATS.sitemap, ext: true },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__motto">{SITE.motto}</p>
      <p class="site-footer__desc">
        {SITE.name}。写代码，也写生活。
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="页脚导航">
      {
        COLUMNS.map((col) => (
          <div class="site-footer__col">
            <h2 class="site-footer__col-title">{col.title}</h2>
            <ul role="list" class="site-footer__list">
              {col.links.map((link) => (
                <li>
                  {link.ext ? (
                    <a href={link.href} target="_blank" rel="noopener">
                      {link.label}
                    </a>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="site-footer__col">
        <h2 class="site-footer__col-title">保持联系</h2>
        <ul role="list" class="site-footer__list">
          {
            SOCIALS.map((s) => (
              <li>
                <a
                  href={s.href}
                  {...(s.href.startsWith("http")
                    ? { target: "_blank", rel: "noopener" }
                    : {})}
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    {/*
      访问统计。

      数据来自自建不蒜子（参考 https://dusays.com/posts/771/）。
      官方脚本用 POST + x-bsz-referer 头请求，按域名分别计数，
      站点级指标是 site_pv（总访问量）与 site_uv（总访客数）。

      这里复刻它的元素 id 约定（前缀 busuanzi），但自己控制加载时机与样式：
      脚本滚到页脚才注入，避免为一个页脚数字拖慢首屏。
      数字位在服务端就渲染成占位符，脚本到达后原地替换，不会造成布局跳动。
    */}
    <div class="site-footer__stats" id="site-stats" data-state="idle">
      <span class="stats__item">
        <svg class="stats__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path
            d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
          <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"
          ></circle>
        </svg>
        <span class="stats__label">总访问量</span>
        <span class="stats__value" id="busuanzi_site_pv">—</span>
        <span class="stats__unit">次</span>
      </span>

      <span class="stats__sep" aria-hidden="true"></span>

      <span class="stats__item">
        <svg class="stats__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path
            d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <circle cx="12" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="1.8"
          ></circle>
        </svg>
        <span class="stats__label">总访客数</span>
        <span class="stats__value" id="busuanzi_site_uv">—</span>
        <span class="stats__unit">人</span>
      </span>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {year} {SITE.name} · 内容采用{" "}
        <a href={SITE.license.href} target="_blank" rel="noopener">
          {SITE.license.text}
        </a>{" "}
        许可
      </p>
      <p class="site-footer__icp">
        {
          SITE.icp.map((item, i) => (
            <>
              {i > 0 ? " · " : null}
              <a href={item.href} target="_blank" rel="noopener">
                {item.text}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </div>
</footer>
