.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Additional logs
logs
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage (additional)
*.lcov
.nyc_output

# Dependency directories (additional)
jspm_packages/

# Cache directories
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache

# Build cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional files
.node_repl_history
*.tgz
.yarn-integrity

# Additional build outputs
.nuxt
dist
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Tencent Cloud EdgeOne
# 注意：.env 是【有意提交】的（全部为 NEXT_PUBLIC_ 公开变量），
# 以便 Git 部署时构建阶段即可直接读取，无需在平台后台逐项配置。
# 如需改为平台端管理环境变量，请删除本文件中的 .env 并执行 git rm --cached .env
.edgeone/*
.tef_dist/*
  