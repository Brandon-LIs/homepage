{
  "name": "brandon-homepage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Brandon 的个人主页 · oopss.top",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-posts.mjs || echo '⚠ RSS 抓取失败，沿用已有 posts.json 继续构建' ; astro build && node scripts/subset-font-after-build.mjs && node scripts/build-og.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "satori": "^0.35.0",
    "typescript": "^5.9.0",
    "cookie": "^2.0.1",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@astrojs/check": "^0.9.0",
    "subset-font": "^2.9.0",
    "fontkit": "^2.0.4"
  }
}
