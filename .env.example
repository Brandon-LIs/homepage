# ========================================
# 🏠 个人主页 · 环境变量模板
# ========================================
#
# 📋 使用方法：
#   cp .env.example .env.local   # 本地开发用
#   或直接编辑仓库根目录的 .env   # Git 部署用（已提交）
#
# ⚠️ 三条关键规则：
#   1. 所有变量必须以 NEXT_PUBLIC_ 开头，否则客户端读不到
#   2. JSON 变量（SOCIALS / PROJECTS）必须写在【同一行】，
#      跨行会导致 dotenv 只读到 "[" 而解析失败、页面对应区块变空
#   3. 改完变量要重新构建（next dev / next build）才会生效
#
# ⚠️ 全部变量均为 NEXT_PUBLIC_ 前缀，会打包进客户端产物、可被任何人查看。
#    切勿在此存放密钥、密码、Token 等敏感信息。
#
# ⚠️ NEXT_PUBLIC_SITE_URL 决定 canonical / OG / sitemap.xml 指向的域名，
#    换域名后务必同步修改，否则 SEO 标签会指向旧域名。

# ========================================
# 🌐 网站基本信息
# ========================================

# 浏览器标签页标题（含关键词，利于搜索收录）
NEXT_PUBLIC_SITE_TITLE=你的名字 | 个人主页

# 搜索结果里的站点描述，建议 50-160 字
NEXT_PUBLIC_SITE_DESCRIPTION=专注前端开发的个人主页，展示技术栈与开源项目

# 站点正式域名（决定 canonical、Open Graph、sitemap.xml）
NEXT_PUBLIC_SITE_URL=https://example.com

# 浏览器标签页图标
NEXT_PUBLIC_FAVICON_PATH=https://example.com/favicon.ico

# iOS 添加到主屏幕的图标（建议 180x180 PNG）
NEXT_PUBLIC_APPLE_ICON_PATH=/avatar.jpg

# ========================================
# 👤 个人信息
# ========================================

# 页脚版权署名
NEXT_PUBLIC_PROFILE_NAME=你的名字

# 首页大标题前半部分
NEXT_PUBLIC_SITE_NAME=yoursite

# 首页大标题后半部分（域名后缀，如 .com）
NEXT_PUBLIC_SITE_DOMAIN=.com

# 头像 alt 文本，支持 {name} 变量
NEXT_PUBLIC_PROFILE_AVATAR_ALT={name} avatar

# next/image 允许的远程图片域名（用本地图片可忽略）
NEXT_PUBLIC_IMAGE_HOSTNAME=example.com

# Hero 区打字机座右铭
NEXT_PUBLIC_PROFILE_MOTTO=保持好奇，持续前进

# 所在地，显示为「国家·城市」
NEXT_PUBLIC_PROFILE_LOCATION=中国·北京

# 身份标签
NEXT_PUBLIC_PROFILE_ROLE=前端开发工程师

# 头像图片路径（本地文件放 public/ 下，用 /xxx.jpg 引用）
NEXT_PUBLIC_PROFILE_AVATAR=/avatar.jpg

# 个人简介，支持 {location} 和 {role} 变量替换
NEXT_PUBLIC_PROFILE_DESCRIPTION=我是来自{location}的{role}，热爱技术与开源。

# ICP 备案号，无备案请留空
NEXT_PUBLIC_ICP_NUMBER=

# ========================================
# 🔗 社交链接（⚠️ 必须单行 JSON）
# ========================================
# 可用平台名：Blog / Bilibili / GitHub / QQ / Website / Twitter / LinkedIn
# 自定义平台需在 src/components/SocialIcon.tsx 中添加图标映射
NEXT_PUBLIC_SOCIALS=[{"name":"GitHub","url":"https://github.com/yourname"},{"name":"Blog","url":"https://example.com"}]

# ========================================
# 💻 技能标签（逗号分隔）
# ========================================
NEXT_PUBLIC_LANGUAGES=TypeScript,JavaScript,Python

NEXT_PUBLIC_FRAMEWORKS_AND_TOOLS=React,Next.js,Node.js,Docker

# ========================================
# 🚀 精选项目（⚠️ 必须单行 JSON）
# ========================================
# 字段：title 项目名 / url 链接 / description 简介 / tags 标签数组
# 建议 3-8 个项目
NEXT_PUBLIC_PROJECTS=[{"title":"示例项目","url":"https://github.com/yourname/repo","description":"这是一个示例项目","tags":["React","工具"]}]